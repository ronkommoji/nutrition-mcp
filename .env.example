# Reference only. The server does NOT read a .env file.
# Pass these as the `env` block in your agent's MCP config (see docs/install/).
# All are optional — the server runs on local fallback data when unset.

# Storage location (default: ~/.nutrition-mcp)
NUTRITION_MCP_HOME=~/.nutrition-mcp

# Enables Gemini-based estimation
GEMINI_API_KEY=

# Enables FatSecret lookups (both required)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
